# Copier ce fichier en .env puis remplir les valeurs. Ne jamais versionner .env.
# Generer un secret : openssl rand -base64 48

# --- Base de donnees ---
DB_PASSWORD=

# --- Securite (32 caracteres minimum chacun) ---
JWT_SECRET=
APP_CLE_CHIFFREMENT=

# --- Premier administrateur (cree au premier demarrage, si la base est vide) ---
# Il devra changer ce mot de passe et activer la 2FA a sa premiere connexion.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Adresse publique ---
# Local :
APP_URL=http://localhost:8088
SITE_ADDRESS=:80
HTTP_PORT=8088
HTTPS_PORT=8443
# Production (exemple) :
# APP_URL=https://madeqrcard.mon-domaine.com
# SITE_ADDRESS=madeqrcard.mon-domaine.com
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Connexion avec Google (facultatif) ---
# Console Google Cloud > Identifiants > ID client OAuth (application Web)
# URI de redirection autorisee : <APP_URL>/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Envoi des emails (code de verification a l'inscription) ---
# Sans MAIL_HOST, aucun email n'est envoye : le code est ecrit dans les logs de l'API
# (docker compose logs madeqrcard-app). A n'utiliser qu'en developpement.
# Exemple Brevo : MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Adresse d'expedition, validee chez le fournisseur SMTP
MAIL_FROM=

# Ports du Traefik (HTTPS) sur la machine
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
